# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# AI_MOCK=1 prova il flusso senza chiamare Gemini né Comfy

# "Prova i colori sulla tua stanza" (sul telefono): Comfy Cloud con GPT Image 2,
# la stessa chiave di ManyTask e LeadWin
COMFY_API_KEY=
